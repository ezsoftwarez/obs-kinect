uniform float4x4 ViewProj;
uniform texture2d Image;
uniform float2 InvImageSize;
uniform float EdgeThreshold;
uniform float GlowIntensity;
uniform float4 GlowColor;

sampler_state textureSampler {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData vert_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = vert_in.uv;
	return vert_out;
}

float Luminance(float3 rgb)
{
	return dot(rgb, float3(0.299, 0.587, 0.114));
}

float4 PSEdgeGlow(VertData vert_in) : TARGET
{
	float2 uv  = vert_in.uv;
	float2 off = InvImageSize;

	float4 color = Image.Sample(textureSampler, uv);

	float tl = Luminance(Image.Sample(textureSampler, uv + float2(-off.x, -off.y)).rgb);
	float tm = Luminance(Image.Sample(textureSampler, uv + float2(    0,  -off.y)).rgb);
	float tr = Luminance(Image.Sample(textureSampler, uv + float2( off.x, -off.y)).rgb);
	float ml = Luminance(Image.Sample(textureSampler, uv + float2(-off.x,      0)).rgb);
	float mr = Luminance(Image.Sample(textureSampler, uv + float2( off.x,      0)).rgb);
	float bl = Luminance(Image.Sample(textureSampler, uv + float2(-off.x,  off.y)).rgb);
	float bm = Luminance(Image.Sample(textureSampler, uv + float2(    0,   off.y)).rgb);
	float br = Luminance(Image.Sample(textureSampler, uv + float2( off.x,  off.y)).rgb);

	float gx = -tl - 2.0*ml - bl + tr + 2.0*mr + br;
	float gy = -tl - 2.0*tm - tr + bl + 2.0*bm + br;
	float edge = sqrt(gx*gx + gy*gy);

	float glowStrength = smoothstep(EdgeThreshold, EdgeThreshold + 0.1, edge) * GlowIntensity;

	float3 result = color.rgb + GlowColor.rgb * glowStrength;
	return float4(saturate(result), color.a);
}

technique EdgeGlow
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSEdgeGlow(vert_in);
	}
}
