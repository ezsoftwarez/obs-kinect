uniform float4x4 ViewProj;
uniform texture2d Image;
uniform float HueShift;
uniform float Saturation;
uniform float Brightness;
uniform float Contrast;
uniform float Gamma;

sampler_state textureSampler {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData vert_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = vert_in.uv;
	return vert_out;
}

float3 RGBtoHSV(float3 rgb)
{
	float cmax  = max(rgb.r, max(rgb.g, rgb.b));
	float cmin  = min(rgb.r, min(rgb.g, rgb.b));
	float delta = cmax - cmin;

	float h = 0.0;
	if (delta > 0.0) {
		if (cmax == rgb.r)
			h = fmod((rgb.g - rgb.b) / delta, 6.0) / 6.0;
		else if (cmax == rgb.g)
			h = ((rgb.b - rgb.r) / delta + 2.0) / 6.0;
		else
			h = ((rgb.r - rgb.g) / delta + 4.0) / 6.0;
	}
	if (h < 0.0) h += 1.0;

	float s = (cmax > 0.0) ? (delta / cmax) : 0.0;
	float v = cmax;
	return float3(h, s, v);
}

float3 HSVtoRGB(float3 hsv)
{
	float h = hsv.x * 6.0;
	float s = hsv.y;
	float v = hsv.z;
	float c = v * s;
	float x = c * (1.0 - abs(fmod(h, 2.0) - 1.0));
	float m = v - c;

	float3 rgb;
	if      (h < 1.0) rgb = float3(c, x, 0);
	else if (h < 2.0) rgb = float3(x, c, 0);
	else if (h < 3.0) rgb = float3(0, c, x);
	else if (h < 4.0) rgb = float3(0, x, c);
	else if (h < 5.0) rgb = float3(x, 0, c);
	else              rgb = float3(c, 0, x);

	return rgb + float3(m, m, m);
}

float4 PSColorGrading(VertData vert_in) : TARGET
{
	float4 color = Image.Sample(textureSampler, vert_in.uv);

	float3 hsv = RGBtoHSV(color.rgb);
	hsv.x = fmod(hsv.x + HueShift / 360.0 + 1.0, 1.0);
	hsv.y = saturate(hsv.y * Saturation);
	float3 rgb = HSVtoRGB(hsv);

	rgb = (rgb - 0.5) * Contrast + 0.5 + Brightness;
	rgb = pow(saturate(rgb), float3(1.0 / Gamma, 1.0 / Gamma, 1.0 / Gamma));

	return float4(saturate(rgb), color.a);
}

technique ColorGrading
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSColorGrading(vert_in);
	}
}
